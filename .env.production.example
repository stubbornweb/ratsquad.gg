# The clan's REAL services. Copy to .env.production (git-ignored).
#
# This file configures the live RATS guild, the live Discord application and
# the `rats-site` database. A migration run against it is not reversible by
# editing a file.
#
# Loaded by:  make check-provisioning, make db-migrate-prod, make discord-roles,
#             make discord-channels — each names this file explicitly.
# NOT loaded by `next dev`: Next.js picks .env.development there, and cannot be
# told otherwise. Touching production is always a deliberate command.
#
# On Vercel this file is irrelevant — Vercel never reads a repo .env file. The
# same names live in the project's PRODUCTION environment scope, including
# APP_ENV.
#
# Never prefix any of these with NEXT_PUBLIC_ — that inlines the value into the
# browser bundle. `make check-provisioning` fails if one of them leaks that way.
#
# Non-secret Discord IDs (guild, roles, channels) are NOT env vars: they live in
# src/consts/discord.ts.

# --- Which services these values point at --------------------------------
# The only thing that distinguishes this file from .env.development, since the
# credential names are identical in both. Callers that must not run against the
# wrong target assert on it. Not a secret.
APP_ENV=production

# --- Discord bot ---------------------------------------------------------
# https://discord.com/developers/applications → RATS HQ → Bot → Reset Token
# Needs the SERVER MEMBERS and MESSAGE CONTENT privileged intents.
DISCORD_BOT_TOKEN=

# --- Discord OAuth (site login) ------------------------------------------
# Same app → OAuth2. The client secret is shown once; reset it if lost.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match a redirect URI registered on the app, character for character.
DISCORD_REDIRECT_URI=https://ratsquad.vercel.app/api/auth/callback

# --- Turso ---------------------------------------------------------------
# turso db show rats-site --url  /  turso db tokens create rats-site
# libsql:// and https:// are Turso; file: is the self-hosted exit path.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
