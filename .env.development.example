# The THROWAWAY counterparts. Copy to .env.development (git-ignored).
#
# A separate Discord application in a test guild, and a separate database — so
# a half-built registration flow writes invented profiles somewhere they can be
# deleted, not into the clan's real data.
#
# Loaded by:  next dev (automatically — Next.js reads .env.$NODE_ENV, and
#             `next dev` is always NODE_ENV=development), make db-migrate,
#             make db-studio.
#
# ⚠️ .env.local takes precedence over this file in Next.js. If one exists it
# silently shadows everything here. There should be no .env.local in this repo.
#
# On Vercel this file is irrelevant — Vercel never reads a repo .env file. The
# same names live in the project's PREVIEW environment scope, including
# APP_ENV. A Preview build runs with NODE_ENV=production, so the scope is the
# only thing pointing previews at these services.
#
# Never prefix any of these with NEXT_PUBLIC_ — that inlines the value into the
# browser bundle.
#
# Non-secret Discord IDs (guild, roles, channels) are NOT env vars: they live in
# src/consts/discord.ts.

# --- Which services these values point at --------------------------------
# The only thing that distinguishes this file from .env.production, since the
# credential names are identical in both. Callers that must not run against the
# wrong target assert on it. Not a secret.
APP_ENV=development

# --- Discord bot ---------------------------------------------------------
# https://discord.com/developers/applications → RATS HQ Dev → Bot → Reset Token
# Needs the SERVER MEMBERS and MESSAGE CONTENT privileged intents, same as the
# real app — intents are per-application and do not carry over.
DISCORD_BOT_TOKEN=

# --- Discord OAuth (site login) ------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match a redirect URI registered on the DEV app, character for character.
# The stable preview alias is pinned to the develop branch; any other branch
# gets a hostname Discord will reject, by design.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Turso ---------------------------------------------------------------
# turso db show rats-site-dev --url  /  turso db tokens create rats-site-dev
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
